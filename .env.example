# Copy to .env and adjust local paths. Never commit credentials.
VCLASP_ROOT=/absolute/path/to/vclasp
VCLASP_PYTHON=/absolute/path/to/vclasp/.venv/bin/python
VCLASP_TEST_CHUNK=/absolute/path/to/private/fixture.chunk

# Existing deployments may override these roots without changing source code.
VCLASP_MINIO_ROOT=/data/vclasp/minio
VCLASP_AISTORE_ROOT=/data/vclasp/aistore

# S3-compatible client configuration. Keep secrets only in .env.
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ALLOW_HTTP=true
